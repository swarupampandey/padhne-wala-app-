# ============================================================================
# NEET AI Suite - Environment Configuration
# ============================================================================
#
# Copy this file to .env and fill in the values.
#
# For LOCAL DEVELOPMENT:
#   - Leave DATABASE_URL empty to use SQLite (auto-created)
#   - Gemini API key is optional; app will still work without it
#
# For PRODUCTION:
#   - Provide a PostgreSQL DATABASE_URL
#   - Configure all required API keys
#

# ─────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# 
# For development: Leave empty to auto-use SQLite in ./data/neet.db
# For production: Use PostgreSQL
#   Example: postgresql://user:password@localhost:5432/neet_db
#
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# 
# Port for API server
# Default: 3000 (dev), 8080 (production)
#
PORT=3000

# API base URL for frontend (only needed if backend on different host)
# Leave empty for same-origin (localhost:3000/api)
# Example for remote: https://api.example.com
#
VITE_API_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────
# AI PROVIDER KEYS (Optional)
# ─────────────────────────────────────────────────────────────────────────
#
# These keys can also be set via the Settings page in the app.
# If set here, they will be used automatically.
#
# Google Gemini (Free)
# Get key: https://aistudio.google.com/apikey
#
GEMINI_API_KEY=

# OpenAI API Key (GPT-4o, GPT-3.5-turbo)
# Get key: https://platform.openai.com/api-keys
#
OPENAI_API_KEY=

# Together AI Key (for image generation)
# Get key: https://api.together.xyz
#
TOGETHER_AI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# DEPLOYMENT OPTIONS
# ─────────────────────────────────────────────────────────────────────────
#
# Set to 'production' for optimized builds and strict error handling
#
NODE_ENV=development

# Base path for frontend assets (default: /)
# Use this if deploying to a subdirectory
#
BASE_PATH=/
